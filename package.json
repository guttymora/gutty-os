{
    "name": "gutty-os",
    "productName": "GuttyOS",
    "version": "1.0.0",
    "private": true,
    "description": "Retro-styled game library frontend for GuttyOS",
    "keywords": [],
    "license": "MIT",
    "author": {
        "name": "guttymora",
        "email": "tavo.mora92@hotmail.com"
    },
    "main": ".vite/build/main.cjs",
    "packageManager": "pnpm@11.11.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "release": "electron-forge release",
        "lint": "eslint --ext .ts,.tsx .",
        "lint:fix": "eslint --ext .ts,.tsx . --fix",
        "prettier:check": "prettier --check \"src/**/*.{ts,tsx}\"",
        "prettier:write": "prettier --write \"src/**/*.{ts,tsx}\"",
        "typecheck": "tsc --noEmit -p .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "electron-forge package && playwright test",
        "build:check": "electron-forge package && node scripts/smoke-packaged.mjs && rm -rf out",
        "ci": "pnpm run prettier:check && pnpm run lint && pnpm run typecheck && pnpm run test",
        "ci:full": "pnpm run prettier:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build:check && playwright test"
    },
    "devDependencies": {
        "@electron-forge/cli": "8.0.1",
        "@electron-forge/maker-zip": "8.0.1",
        "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
        "@electron-forge/plugin-fuses": "8.0.1",
        "@electron-forge/plugin-vite": "8.0.1",
        "@electron/fuses": "2.1.3",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.0",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/coverage-v8": "5.0.3",
        "electron": "44.7.0",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "jiti": "2.7.0",
        "jsdom": "30.1.2",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1",
        "vite": "8.3.4",
        "vitest": "5.0.3"
    },
    "dependencies": {
        "@fontsource-variable/pixelify-sans": "5.3.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "zustand": "5.0.15"
    }
}
